<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging configuration. Every service includes this from its own
  logback-spring.xml:

      <include resource="com/payorch/infra/logging/logback-payorch.xml"/>

  Two independent masking controls are wired onto the encoder:

    1. MaskingJsonGeneratorDecorator + SensitiveDataValueMasker
       Regex + Luhn redaction over every string value written to the output,
       whatever produced it. The last-resort net.

    2. SensitiveMapperBuilderDecorator
       Registers the @Sensitive Jackson module on the encoder's own mapper, so
       objects passed as structured arguments are masked by annotation. The
       encoder does not use Spring's ObjectMapper, so this cannot be left to
       LoggingAutoConfiguration.

  Neither is the primary control. Tokenization at the edge is.
-->
<included>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMasker class="com.payorch.infra.logging.mask.SensitiveDataValueMasker"/>
            </decorator>

            <decorator class="com.payorch.infra.logging.jackson.SensitiveMapperBuilderDecorator"/>

            <!-- SERVICE_NAME is set per container in docker-compose.yml. Without
                 it, log lines from six services are indistinguishable. -->
            <customFields>{"service":"${SERVICE_NAME:-unknown}"}</customFields>
        </encoder>
    </appender>

    <!--
      Phase 4: the same events, shipped to the collector.

      This is what makes a log line and its trace one click apart in SigNoz
      rather than a traceId you grep for. The appender takes the ACTIVE trace
      context from the emitting thread, which is why 4a's work on carrying that
      context across DeadlineExecutor's handoff had to come first - without it
      these lines would arrive attached to the wrong trace, or to none.

      It does NOT replace the JSON console appender above, and must not. The
      container logs are what `docker compose logs` shows during an experiment
      and what the PAN-leak test scans; trading them for an export that needs a
      browser to read would be a downgrade for every workflow this project has.

      In a service with no OpenTelemetry SDK installed - psp-router,
      ledger-notifier - this drops what it is given and costs nothing.
    -->
    <appender name="OTEL"
              class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <!-- MDC carries merchantId, paymentId, correlationId and the rest of
             LogFields. Those are the attributes worth filtering a log search
             by, and dropping them here would leave SigNoz with the message and
             nothing to narrow it down with. -->
        <captureMdcAttributes>*</captureMdcAttributes>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureLoggerContext>true</captureLoggerContext>
    </appender>

    <!-- LOG_LEVEL is overridable per container, and at runtime via
         /actuator/loggers - phase 4 needs DEBUG on one service for ninety
         seconds mid-chaos-run without a restart. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON"/>
        <appender-ref ref="OTEL"/>
    </root>

</included>
