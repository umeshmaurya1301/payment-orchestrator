<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging configuration. Every service includes this from its own
  logback-spring.xml:

      <include resource="com/payorch/infra/logging/logback-payorch.xml"/>

  Two independent masking controls are wired onto the encoder:

    1. MaskingJsonGeneratorDecorator + SensitiveDataValueMasker
       Regex + Luhn redaction over every string value written to the output,
       whatever produced it. The last-resort net.

    2. SensitiveMapperBuilderDecorator
       Registers the @Sensitive Jackson module on the encoder's own mapper, so
       objects passed as structured arguments are masked by annotation. The
       encoder does not use Spring's ObjectMapper, so this cannot be left to
       LoggingAutoConfiguration.

  Neither is the primary control. Tokenization at the edge is.
-->
<included>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMasker class="com.payorch.infra.logging.mask.SensitiveDataValueMasker"/>
            </decorator>

            <decorator class="com.payorch.infra.logging.jackson.SensitiveMapperBuilderDecorator"/>

            <!-- SERVICE_NAME is set per container in docker-compose.yml. Without
                 it, log lines from six services are indistinguishable. -->
            <customFields>{"service":"${SERVICE_NAME:-unknown}"}</customFields>
        </encoder>
    </appender>

    <!-- LOG_LEVEL is overridable per container, and at runtime via
         /actuator/loggers - phase 4 needs DEBUG on one service for ninety
         seconds mid-chaos-run without a restart. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON"/>
    </root>

</included>
